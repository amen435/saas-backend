# Database — must be a real host (NOT the word "host"). Local example:
# For deployment with Neon, copy the direct connection string and keep sslmode=require:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/saas

# JWT/session (same secret must be used for every sign + verify; rotate = everyone re-logs in)
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRY=1d
# Production (HTTPS): None or unset so Vercel→Render cookies work. Local + Vite /api proxy only: can use Lax.
COOKIE_SAME_SITE=None
# Keep disabled in production: do not expose JWT to JavaScript.
ACCESS_TOKEN_IN_BODY=false

# 32-byte data encryption key for encrypted fields. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=replace-with-a-random-64-hex-character-key

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
APP_BASE_URL=http://localhost:5000

# Frontend origins allowed by CORS (comma-separated). Localhost + saas-alpha-gold.vercel.app are
# in server defaults; still set this for previews/custom domains, e.g.:
# FRONTEND_URL=https://saas-intellicampuse.vercel.app,https://your-custom-domain.com
# Cross-origin cookies (Vercel → Render): use None in production (defaults to None if unset):
# COOKIE_SAME_SITE=None
# Allow https://*.vercel.app (default false). Set true only if you explicitly need preview domains:
# CORS_ALLOW_VERCEL_PREVIEW=false
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_VERCEL_PREVIEW=false

# AI Configuration
GEMINI_API_KEY=replace-with-real-api-key
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_RATE_LIMIT_PER_MINUTE=10
